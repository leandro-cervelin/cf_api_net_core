# Copy this file to `.env` (same folder as docker-compose.yml) and set a strong password.
# `.env` is gitignored and must never be committed.
# SQL Server requires a strong SA password (>=8 chars, upper/lower/digit/symbol).
SA_PASSWORD=ChangeMe_Strong#Passw0rd

# HMAC key that signs API access tokens (JWT). Must be at least 32 bytes; generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=ChangeMe_generate_a_random_value_of_at_least_32_bytes
