{
  "ConnectionStrings": {
    "DbConnection": "Data Source=db;Initial Catalog=CF;User ID=cf_app;Trusted_Connection=false;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "cf-api",
    "Audience": "cf-api",
    "ExpiryMinutes": 60,
    "SecurityStampCacheSeconds": 30,
    "AdminCustomerIds": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
