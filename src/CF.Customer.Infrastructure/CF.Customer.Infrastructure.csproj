<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <!-- Microsoft.Data.SqlClient (via EF Core SqlServer) brings in an older System.Security.Cryptography.Pkcs (9.0.x), a line
         that has had advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). Pinned to the current release so every project that
         uses this one gets it. Remove once SqlClient depends on a patched version and NuGet audit stays clean without it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CF.Customer.Application\CF.Customer.Application.csproj" />
    <ProjectReference Include="..\CF.Customer.Domain\CF.Customer.Domain.csproj" />
  </ItemGroup>
</Project>