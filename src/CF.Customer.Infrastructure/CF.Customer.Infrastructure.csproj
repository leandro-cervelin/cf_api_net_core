<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Microsoft.Data.SqlClient 6.1.7 (via EF Core SqlServer) pulls in Pkcs 9.0.11, which has known vulnerabilities
         (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). Pinned here so every project that uses this one gets the patched version.
         Remove once EF Core SqlServer depends on a patched SqlClient. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CF.Customer.Application\CF.Customer.Application.csproj" />
    <ProjectReference Include="..\CF.Customer.Domain\CF.Customer.Domain.csproj" />
  </ItemGroup>
</Project>